<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!--
  Two rules govern this file, and breaking either produces a failure that does not
  name its cause.

  A list result must use the nested element form below,
  <result><type type="space info" list="yes"/></result>. The attribute form,
  <result type="space info" list="yes"/>, silently drops list="yes"; Foundation
  then tries to convert the whole array into a single record and raises
  NSInternalInconsistencyException naming _scriptingDescriptorOfRecordType:.

  A <cocoa class="X"/> name is resolved with NSClassFromString, and Swift registers
  classes under a module-qualified name. Each class named here therefore carries an
  explicit @objc(X) attribute in ScriptCommands.swift. Without that attribute the
  command is never found and every call returns -1708 Message not understood.
-->
<dictionary title="Projects Terminology">
  <suite name="Projects Suite" code="Prjs" description="Commands for driving Projects.">

    <record-type name="space info" code="SpIn" description="A desktop Space.">
      <property name="id" code="ID  " type="text" description="The Space UUID."/>
      <property name="name" code="pnam" type="text" description="The project name; empty when unnamed."/>
      <property name="number" code="SpNo" type="integer" description="The desktop number."/>
      <property name="current" code="SpCu" type="boolean" description="Whether this is the active Space."/>
      <property name="previous" code="SpPv" type="boolean" description="Whether this is the Space that was active before the current one."/>
      <property name="switchable" code="SpSw" type="boolean" description="Whether a Mission Control shortcut is assigned."/>
    </record-type>

    <command name="list spaces" code="PrjsLstS" description="Every desktop Space, in order.">
      <cocoa class="ListSpacesCommand"/>
      <result>
        <type type="space info" list="yes"/>
      </result>
    </command>

    <command name="switch to space" code="PrjsSwtS" description="Switch to the Space with this id.">
      <cocoa class="SwitchToSpaceCommand"/>
      <direct-parameter type="text" description="The Space id, from list spaces."/>
    </command>

    <command name="switch to previous space" code="PrjsPrvS" description="Switch back to the Space that was active before the current one.">
      <cocoa class="SwitchToPreviousSpaceCommand"/>
    </command>

    <command name="open space setup for" code="PrjsOpnS" description="Switch to a Space, then open its saved windows.">
      <cocoa class="OpenSpaceSetupCommand"/>
      <direct-parameter type="text" description="The Space id, from list spaces."/>
    </command>

    <command name="open settings" code="PrjsSetS" description="Open the Settings window at the current Space.">
      <cocoa class="OpenSettingsCommand"/>
    </command>

  </suite>
</dictionary>
